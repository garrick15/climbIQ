# ──────────────────────────────────────────────────────────────────────────
# ClimbIQ — environment variables
#
# HOW TO USE
#   1. Copy this file to `.env.local`:   cp .env.example .env.local
#   2. Paste your Meta Model API key below (replace the placeholder).
#   3. Restart the dev server.
#
# IMPORTANT
#   - This key is read ONLY by the serverless function in `api/coach.ts`.
#     It is never bundled into the frontend. Do NOT prefix it with `VITE_`
#     (anything starting with VITE_ is exposed to the browser).
#   - `.env.local` is git-ignored. Never commit a real key.
#   - On Vercel, set this same variable under:
#     Project → Settings → Environment Variables (name: META_API_KEY).
# ──────────────────────────────────────────────────────────────────────────

# Your Meta Model API key (get one at https://dev.meta.ai).
# ↓↓↓  PASTE YOUR KEY HERE  ↓↓↓
META_API_KEY=

# Optional overrides (sensible defaults are used if left unset).
# Base URL for the OpenAI-compatible Meta Model API.
META_API_BASE_URL=https://api.meta.ai/v1
# Model id used for coaching (multimodal reasoning model).
META_MODEL=muse-spark-1.3
